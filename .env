# --- PocketOption ---
# Laisse vide pour te connecter via la fenêtre de login automatique (pywebview).
POCKET_SSID=
POCKET_DEMO=true

# --- Telegram ---
TELEGRAM_BOT_TOKEN=1234567890:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELEGRAM_CHAT_ID=123456789

# --- Paires suivies (séparées par des virgules) ---
POCKET_PAIRS=EURUSD_otc,GBPUSD_otc,AUDCAD_otc

# --- Fréquence de scan (secondes) ---
SCAN_INTERVAL_SECONDS=5

# --- Mode par stratégie : off / manual / auto / both ---
STRATEGY_5S_MODE=both
STRATEGY_1M_MODE=both
STRATEGY_2M_MODE=both

# --- Mise de base de la martingale (stratégie 5s) ---
MARTINGALE_BASE_AMOUNT=1.0

# --- Seuil de confiance (notification) ---
MIN_CONFIDENCE_TO_NOTIFY=60

# --- Réseau Telegram ---
TELEGRAM_FORCE_IPV4=true
TELEGRAM_TRUST_ENV=true
