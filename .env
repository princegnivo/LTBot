# ===== OBLIGATOIRE =====
TELEGRAM_TOKEN=
# Votre ID Telegram (envoyez /id au bot). Plusieurs admins : 111,222
ADMIN_IDS=

# ===== MARQUE =====
BOT_NAME=LEGIT AI
BOT_USERNAME=
WELCOME_TEXT=

# ===== INSCRIPTION POCKET OPTION =====
# Votre lien d'affiliation complet (bouton S'INSCRIRE + création automatique)
PO_REGISTER_URL=https://u3.shortink.io/register?utm_campaign=860007&utm_source=affiliate&utm_medium=sr&a=xEDBAlbNrwqJDA&al=1787229&ac=legittrade&cid=973429&code=50START
PO_LOGIN_URL=https://pocketoption.com/en/login/
PO_PROFILE_URL=https://pocketoption.com/en/cabinet/profile/
PO_SESSION_COOKIE=ci_session

# 1 = il faut un ID vérifié (inscrit via votre lien) pour utiliser le bot
REQUIRE_VERIFIED=1
# auto | manual | off  (vide = auto si PARTNERS_* remplis, sinon manual)
VERIFY_MODE=
# Votre compte pocketpartners (vérification automatique des ID)
PARTNERS_EMAIL=
PARTNERS_PASSWORD=
PARTNERS_LOGIN_URL=https://pocketpartners.com/en/login
PARTNERS_STATS_URL=https://pocketpartners.com/en/statistics?#traders

# Bouton "TE CRÉER UN COMPTE" (Playwright)
AUTO_SIGNUP=1
SIGNUP_PER_DAY=3
SIGNUP_PER_HOUR_GLOBAL=30

# ===== NAVIGATEUR (PLAYWRIGHT) =====
WEB_HEADLESS=1
WEB_TIMEOUT=45
# 1 sur un petit serveur (moins de 1 Go de RAM)
WEB_CONCURRENCY=2
# Exemple : http://user:pass@host:port (si le site bloque l'IP du serveur)
WEB_PROXY=
# JSON de sélecteurs si Pocket Option change son site
PO_SELECTORS_FILE=

# ===== JETONS, DÉPÔTS, BONUS =====
COST_AUTO_DEMO=1
COST_AUTO_REAL=1
WELCOME_TOKENS=0
REF_BONUS=10
CHANNEL_BONUS=10
BONUS_TOKENS=5
# 0 = bonus unique
BONUS_HOURS=24
# {amount} sera remplacé par le montant du pack
DEPOSIT_URL=https://pocketoption.com/en/cabinet/deposit/?amount={amount}
# dépôt en $ : jetons
DEPOSIT_PACKS=20:200,50:600,100:1500,250:4000,500:10000
PROMO_CODE=50START
PROMO_TEXT=bonus sur votre dépôt

# ===== CANAL, SUPPORT, FAQ =====
# @nom_du_canal (le bot doit en être administrateur). Vide = bouton masqué
CHANNEL_ID=
CHANNEL_URL=
# @votre_support  (ou SUPPORT_URL=https://t.me/...)
SUPPORT_USERNAME=
FAQ_FILE=

# ===== COURTIER =====
# "paper" = simulateur local sans compte
BROKER=pocketoption
# 1 = autorise le mode RÉEL
ALLOW_REAL=0
MAX_REAL_STAKE=20
# Compte DÉMO dédié aux signaux des utilisateurs sans SSID (lecture seule)
PO_SSID_DEMO=
PO_SSID_REAL=

# ===== SYSTÈME =====
# Vide = ./data  (Docker : /data)
DATA_DIR=
# DEBUG pour voir les signaux ignorés
LOG_LEVEL=INFO
