# Installation : sudo cp deploy/ltbot.service /etc/systemd/system/ && sudo systemctl daemon-reload
#                sudo systemctl enable --now ltbot      (journal : journalctl -u ltbot -f)
# Adaptez User et les chemins si besoin.
[Unit]
Description=LTBot (Telegram + Pocket Option)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ltbot
WorkingDirectory=/opt/ltbot
ExecStart=/opt/ltbot/venv/bin/python main.py
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
# durcissement
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/ltbot

[Install]
WantedBy=multi-user.target
